[flake8]
max-line-length = 120
# E711/E712 are ignored globally: this codebase filters almost exclusively
# through SQLAlchemy query expressions, where `Column == True` / `== None`
# builds a SQL predicate and `is`/truthy checks do not — the "==" flake8
# flags here is the required idiom, not a style slip.
extend-ignore = D, I, E261, E501, W291, W293, W292, E302, E305, E701, E402, E401, B008, E111, E117, E114, W391, E122, E127, E128, E711, E712
# F401/F811: main.py; F401: crud.py
# match_engine.py: re-exports match_data/match_db_integration names so other
# modules can import them from core_engine.match_engine directly.
per-file-ignores =
    api_gateway/main.py: F401, F811
    agent_service/crud.py: F401
    api_gateway/validation.py: F401
    core_engine/engine.py: F401
    core_engine/heat.py: B010
    core_engine/rulebook.py: F821
    core_engine/match_engine.py: F401
    models/entities.py: F401
    scripts/demo_multi.py: F811
exclude = .git,__pycache__,venv,.venv,build,dist
